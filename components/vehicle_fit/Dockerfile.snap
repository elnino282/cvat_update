# Optional real SNAP backend. Checkpoint is mounted at runtime, not baked in.
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 \
    TORCH_CUDA_ARCH_LIST=12.0 MAX_JOBS=2 SNAP_SOURCE=/opt/SNAP \
    SNAP_CHECKPOINT=/weights/SNAP_Outdoor.pth SNAP_ATTENTION=flash \
    SNAP_CHECKPOINT_SHA256=266b00df105b494e9c86d416f4715bf615baf2ba6c830c298f02e3dbebedd8bb

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip build-essential git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY components/vehicle_fit/requirements-snap*.txt /tmp/
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements-snap-cuda.txt && \
    python3 -m pip install --no-cache-dir -r /tmp/requirements-snap.txt && \
    python3 -m pip install --no-cache-dir --no-build-isolation -r /tmp/requirements-snap-flash.txt
RUN git clone https://github.com/neu-vi/SNAP.git /opt/SNAP && \
    git -C /opt/SNAP checkout 59fa79b3948e2a9aec4e69efccb1f0677bdb4295

COPY components/vehicle_fit/*.py /app/components/vehicle_fit/
COPY components/vehicle_fit/data/ /app/components/vehicle_fit/data/
ENV VEHICLE_FIT_BACKEND=snap VEHICLE_FIT_PORT=8093
EXPOSE 8093
CMD ["python3", "-m", "components.vehicle_fit.service"]
